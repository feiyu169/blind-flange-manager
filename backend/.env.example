# 盲板管理系统 - 环境变量配置模板
# 复制此文件为 .env 并填入实际值

# 数据库配置
# 开发环境使用 SQLite
DATABASE_URL=sqlite+aiosqlite:///./blind_flange_manager.db
# 生产环境使用 PostgreSQL
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/blind_flange_manager

# Redis 配置
REDIS_URL=redis://localhost:6379/0

# JWT 配置（生产环境必须修改！）
# 生成密钥: openssl rand -hex 32
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# 调试模式（生产环境设为 false）
DEBUG=true

# CORS 配置（生产环境设为实际域名）
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# 文件上传配置
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=10485760
